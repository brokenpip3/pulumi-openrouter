        "getCredits.ts",
        "getGuardrail.ts",
        "getGuardrailKeyAssignments.ts",
        "getGuardrailMemberAssignments.ts",
        "getGuardrailPolicyBudget.ts",
        "getGuardrailPolicyModelAvailability.ts",
        "getGuardrailPolicyModeration.ts",
        "getGuardrails.ts",
        "getModel.ts",
        "getModels.ts",
        "getObservabilityDestination.ts",
        "getObservabilityDestinations.ts",
        "getOrganizationMembers.ts",
        "getOrganizationSettings.ts",
        "getPreset.ts",
        "getPresets.ts",
        "getPrivateEndpoint.ts",
        "getProviders.ts",
        "getScimGroupMapping.ts",
        "getScimGroups.ts",
        "getWorkspace.ts",
        "getWorkspaceBudget.ts",
